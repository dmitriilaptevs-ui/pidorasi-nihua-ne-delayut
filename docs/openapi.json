  "components": {
    "schemas": {
      "CreditRequest": {
        "properties": {
          "email": {
            "type": "string",
            "format": "email",
            "title": "Email"
          },
          "amount_kopecks": {
            "type": "integer",
            "maximum": 100000000.0,
            "minimum": 1.0,
            "title": "Amount Kopecks"
          },
          "reference": {
            "type": "string",
            "maxLength": 120,
            "minLength": 3,
            "title": "Reference"
          }
        },
        "type": "object",
        "required": [
          "email",
          "amount_kopecks",
          "reference"
        ],
        "title": "CreditRequest"
      },
      "ForgotRequest": {
        "properties": {
          "email": {
            "type": "string",
            "format": "email",
            "title": "Email"
          }
        },
        "type": "object",
        "required": [
          "email"
        ],
        "title": "ForgotRequest"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "KeyCreateRequest": {
        "properties": {
          "name": {
            "type": "string",
            "maxLength": 64,
            "minLength": 1,
            "title": "Name"
          },
          "monthly_limit_kopecks": {
            "anyOf": [
              {
                "type": "integer",
                "minimum": 0.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Monthly Limit Kopecks"
          }
        },
        "type": "object",
        "required": [
          "name"
        ],
        "title": "KeyCreateRequest"
      },
      "LoginRequest": {
        "properties": {
          "email": {
            "type": "string",
            "format": "email",
            "title": "Email"
          },
          "password": {
            "type": "string",
            "maxLength": 200,
            "minLength": 1,
            "title": "Password"
          }
        },
        "type": "object",
        "required": [
          "email",
          "password"
        ],
        "title": "LoginRequest"
      },
      "PaymentCreateRequest": {
        "properties": {
          "amount_kopecks": {
            "type": "integer",
            "maximum": 100000000.0,
            "minimum": 1.0,
            "title": "Amount Kopecks"
          }
        },
        "type": "object",
        "required": [
          "amount_kopecks"
        ],
        "title": "PaymentCreateRequest"
      },
      "RefundRequest": {
        "properties": {
          "amount_kopecks": {
            "anyOf": [
              {
                "type": "integer",
                "minimum": 1.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Amount Kopecks"
          }
        },
        "type": "object",
