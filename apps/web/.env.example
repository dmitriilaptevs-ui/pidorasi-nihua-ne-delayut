# LOCAL onboarding lab only. Keep this file placeholder-only.
# VK ID supports localhost on ports 80/443; the app itself listens on 3001.
APP_ORIGIN=http://localhost

# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SESSION_SECRET=

# From your existing VK ID WEB application. Never publish actual credentials.
# Base domain: localhost
# Trusted redirect URL: http://localhost/api/auth/callback/vk
VK_CLIENT_ID=
# Set to public or confidential to match the provider application, not to bypass it.
VK_APP_TYPE=confidential
# Required for confidential apps; allowlist your backend's outbound IP in VK settings.
VK_SERVICE_TOKEN=

# From your existing Yandex ID web application. Scope needed: login:info
# Redirect URI: http://localhost/api/auth/callback/yandex
YANDEX_CLIENT_ID=
# Optional when using PKCE, but supported for confidential application setups.
YANDEX_CLIENT_SECRET=

# This file is consumed by the API for OAuth credentials. Do not put provider
# keys here: infra/docker-compose.yml does not pass this file to the web service.
