# Copy to infra/.env (mode 0600) and edit. Never commit real values.
# OAuth credentials remain in apps/web/.env.local and are read by the API.
# Provider credentials and runtime tokens below are injected into the API only.

# PostgreSQL credentials used by the db service and the api DSN.
POSTGRES_DB=rubai
POSTGRES_USER=rubai
POSTGRES_PASSWORD=replace-with-a-long-random-value

# Public HTTPS origin served by the tunnel, e.g. https://<id>.lhr.life
# or https://dima-laptop.tail4a5896.ts.net (no trailing slash).
PUBLIC_ORIGIN=https://example.invalid

# Platform-funded OpenRouter requests. Keep the key on the API host only.
# Customer BYOK keys are submitted in the account UI and encrypted at rest
# with PROVIDER_KEY_ENCRYPTION_KEY; they are never sent to the web container.
OPENROUTER_API_KEY=
# Generate a random 32-byte URL-safe Base64 value before accepting BYOK keys.
PROVIDER_KEY_ENCRYPTION_KEY=

# Required in production for a Sites Worker proxying requests to this API.
# Configure the same value in the Worker as X-Rubai-Proxy-Token.
API_PROXY_TOKEN=

# Optional local Hermes/Pi broker. Leave empty until it is installed and tested.
AGENT_RUNTIME_URL=
AGENT_RUNTIME_TOKEN=
